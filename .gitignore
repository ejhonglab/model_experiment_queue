# venv, outputs and from_yang at the root may be symlinks to another disk (on hal, to
# /data/tom/claude_moved/model_experiment_queue/, 2026-11-12), and a pattern ending in / matches
# directories only, so each also has a root-anchored pattern without one

# Yang's slide packs, too large for GitHub (>100MB each)
from_yang/
/from_yang

# The original report's analysis and what Remy sent, kept in the shared directory only (CLAUDE.md)
apl_pair_analysis/
from_remy/

# Large outputs of the experiment scripts in this folder. Compact results go to the
# shared NAS directory instead (see CLAUDE.md).
outputs/
/outputs

# This host's copy of its Claude account's Fable-consent record (CLAUDE.md, "Fable consent").
.fable_consent.local

# This repository's venv (CLAUDE.md, "Code changes": al_analysis, hong2p and olfsysm installed
# editable from their checkouts beside this one)
venv/
/venv

# Carried over from al_analysis's .gitignore, which applied while these scripts lived in
# al_analysis/scripts/claude_pair_remapping_experiments (figures, logs and pickles stay out of git:
# compact results go to the shared directory)
*.png
*.svg
*.pdf
*.p
*.nc
*.log
__pycache__/
*.pyc
build/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Claude Code per-machine state (.claude/settings.json is shared)
.claude/scheduled_tasks.lock
.claude/settings.local.json
